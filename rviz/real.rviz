# 實機用的 RViz 設定（飛場 5x4 m），由 drone_nav2_apriltag/rviz/nav2_costmap.rviz 改來：
#   拿掉光達顯示（實機沒裝）、格線 1 m、視角置中在動捕原點、座標軸縮小
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 700
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 10
    Color: 160; 160; 164
    Alpha: 0.5
    Line Style:
      Line Width: 0.03
      Value: Lines
    Reference Frame: <Fixed Frame>
    Plane: XY
    Offset:
      X: 0
      Y: 0
      Z: 0
  - Class: rviz_default_plugins/Map
    Name: 1. 靜態地圖 /map
    Enabled: false
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: true
    Update Topic:
      Value: /map_updates
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Map
    Name: 2. 全域 costmap
    Enabled: true
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Alpha: 1.0
    Color Scheme: costmap
    Draw Behind: true
    Update Topic:
      Value: /global_costmap/costmap_updates
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Axes
    Name: 3. 無人機（base_link 座標軸）
    Enabled: true
    Reference Frame: base_link
    Length: 0.4
    Radius: 0.04
    Show Trail: false
    Value: true
  - Class: rviz_default_plugins/TF
    Name: 4. TF（缺哪段一眼看得出來）
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 2
    Frame Timeout: 15
    Tree: {}
    Frames:
      All Enabled: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 255; 255
    Enabled: true
    Head Diameter: 0.019999999552965164
    Head Length: 0.019999999552965164
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.25
    Name: 5. 規劃出來的路徑 /plan
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.004999999888241291
    Shaft Length: 0.019999999552965164
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 110
      X: 0.0
      Y: 0.0
      Angle: 0
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Front Camera:
    collapsed: false
  Down Camera:
    collapsed: false
  Height: 900
  Width: 1700
  Hide Left Dock: false
  Hide Right Dock: false
